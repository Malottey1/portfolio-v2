---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const TIER_ORDER = { featured: 0, supporting: 1, archive: 2 } as const;

const allProjects = await getCollection('projects');
const projects = allProjects
	.slice()
	.sort((a, b) => {
		const tierDiff = TIER_ORDER[a.data.tier] - TIER_ORDER[b.data.tier];
		return tierDiff !== 0 ? tierDiff : a.data.order - b.data.order;
	})
	.map((p) => ({
		slug: p.id,
		title: p.data.title,
		description: p.data.description,
		stack: p.data.stack,
		dateStart: p.data.dateStart,
		dateEnd: p.data.dateEnd,
		role: p.data.role,
		metric: p.data.metric,
		links: p.data.links,
	}));
---

<Layout title="Arcade — Malcolm Clottey" description="A playable retro platformer version of my portfolio.">
	<main class="arcade" id="main">
		<a class="arcade__exit" href="/">&larr; Back to site</a>
		<button class="arcade__mute" id="muteButton" type="button" aria-pressed="true">🔇 SOUND OFF</button>
		<canvas id="game" class="arcade__canvas" aria-label="Portfolio arcade game"></canvas>
		<pre id="debug" class="arcade__debug"></pre>
	</main>
</Layout>

<style>
	.arcade {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		background: #000;
	}

	.arcade__canvas {
		image-rendering: pixelated;
		image-rendering: crisp-edges;
	}

	.arcade__exit {
		position: fixed;
		top: 16px;
		left: 16px;
		z-index: 10;
		color: #fff;
		font-family: monospace;
		font-size: 14px;
		text-decoration: none;
		padding: 6px 10px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 4px;
	}

	.arcade__mute {
		position: fixed;
		top: 16px;
		right: 16px;
		z-index: 10;
		color: #fff;
		background: rgba(15, 15, 15, 0.7);
		font-family: monospace;
		font-size: 13px;
		font-weight: bold;
		padding: 6px 10px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 4px;
		cursor: pointer;
	}

	.arcade__debug {
		color: #7dff9a;
		font-family: monospace;
		font-size: 12px;
		margin: 0;
	}
</style>

<script is:inline define:vars={{ projects }}>
	window.__ARCADE_PROJECTS__ = projects;
</script>
<script>
	import { startGame } from '../arcade/game';
	import { audio } from '../arcade/audio';
	import type { ProjectSummary } from '../arcade/project-types';

	declare global {
		interface Window {
			__ARCADE_PROJECTS__: ProjectSummary[];
		}
	}

	const canvas = document.getElementById('game') as HTMLCanvasElement | null;
	const debugEl = document.getElementById('debug');
	if (canvas) startGame(canvas, debugEl, window.__ARCADE_PROJECTS__ ?? []);

	const muteButton = document.getElementById('muteButton') as HTMLButtonElement | null;
	function syncMuteButton(muted: boolean) {
		if (!muteButton) return;
		muteButton.textContent = muted ? '🔇 SOUND OFF' : '🔊 SOUND ON';
		muteButton.setAttribute('aria-pressed', String(muted));
	}
	muteButton?.addEventListener('click', () => syncMuteButton(audio.toggleMute()));
	window.addEventListener('arcade-mute-change', (e) => {
		syncMuteButton((e as CustomEvent<{ muted: boolean }>).detail.muted);
	});
</script>
