---
import { getCollection } from 'astro:content';
import ProjectCardFeatured from './ProjectCardFeatured.astro';
import ProjectCardSupporting from './ProjectCardSupporting.astro';
import ProjectCardArchive from './ProjectCardArchive.astro';

const allProjects = await getCollection('projects');
const byTier = (tier: 'featured' | 'supporting' | 'archive') =>
	allProjects
		.filter((entry) => entry.data.tier === tier)
		.sort((a, b) => a.data.order - b.data.order)
		.map((entry) => entry.data);

const featured = byTier('featured');
const supporting = byTier('supporting');
const archive = byTier('archive');
---

<section class="section" id="projects">
	<div class="container">
		<h2 class="section-heading">Projects</h2>

		<div class="projects__tier projects__tier--featured" data-reveal>
			{featured.map((project) => (
				<ProjectCardFeatured project={project} />
			))}
		</div>

		<div class="projects__tier projects__tier--supporting" data-reveal>
			{supporting.map((project) => (
				<ProjectCardSupporting project={project} />
			))}
		</div>

		<div class="projects__tier projects__tier--archive" data-reveal>
			{archive.map((project) => (
				<ProjectCardArchive project={project} />
			))}
		</div>
	</div>
</section>

<style>
	.projects__tier {
		display: grid;
		gap: var(--space-6);
	}

	.projects__tier--featured {
		margin-bottom: var(--space-16);
	}

	/* Fixed column counts (not auto-fit) so a tier never ends on a lone
	   orphan card: 3 supporting cards fill one row, 8 archive cards fill
	   4 or 2 columns evenly. */
	.projects__tier--supporting {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-bottom: var(--space-16);
	}

	.projects__tier--archive {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	@media (max-width: 960px) {
		.projects__tier--supporting {
			grid-template-columns: 1fr;
		}

		.projects__tier--archive {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-4);
		}
	}

	@media (max-width: 600px) {
		.projects__tier--featured,
		.projects__tier--supporting {
			gap: var(--space-4);
			margin-bottom: var(--space-12);
		}

		.projects__tier--archive {
			gap: var(--space-3);
		}
	}
</style>
