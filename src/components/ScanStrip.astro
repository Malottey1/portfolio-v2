---
const items = [
	'Software Engineer',
	'Washington, DC',
	'US Citizen',
	'BSc Computer Science + MS in progress',
	'Python · React · Django · AWS',
	'AWS Certified Developer',
];
---

<div class="scan-strip">
	<div class="container">
		<ul class="scan-strip__list">
			{items.map((item) => (
				<li>{item}</li>
			))}
		</ul>
	</div>
</div>

<style>
	.scan-strip {
		border-block: 1px solid var(--color-border);
	}

	.scan-strip__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		list-style: none;
		margin: 0;
		padding-block: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-text-secondary);
	}

	.scan-strip__list li:not(:last-child)::after {
		content: '·';
		margin-left: var(--space-6);
		color: var(--color-border);
	}
</style>
