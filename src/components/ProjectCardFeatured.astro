---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>['data'];
}

const { project } = Astro.props;
---

<article class="card-featured">
	<div class="card-featured__media">
		<img src={project.image} alt="" loading="lazy" />
	</div>
	<div class="card-featured__body">
		<h3 class="card-featured__title">{project.title}</h3>
		<p class="card-featured__meta">
			{project.dateStart} – {project.dateEnd}
			{project.role && <> · {project.role}</>}
		</p>
		{project.metric && <p class="card-featured__metric">{project.metric}</p>}
		<p class="card-featured__description">{project.description}</p>
		<ul class="card-featured__stack">
			{project.stack.map((tech) => (
				<li>{tech}</li>
			))}
		</ul>
		<div class="card-featured__links">
			{project.links.demo && <a href={project.links.demo}>Live demo</a>}
			{project.links.repo && <a href={project.links.repo}>Repository</a>}
		</div>
	</div>
</article>

<style>
	.card-featured {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: var(--space-8);
		align-items: center;
		padding: var(--space-8);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg-elevated);
	}

	.card-featured__media {
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-card);
	}

	.card-featured__title {
		font-size: var(--text-xl);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-2);
	}

	.card-featured__meta {
		font-size: var(--text-sm);
		color: var(--color-text-secondary);
		margin-bottom: var(--space-4);
	}

	.card-featured__metric {
		font-size: var(--text-lg);
		color: var(--color-accent);
		margin-bottom: var(--space-2);
	}

	.card-featured__description {
		color: var(--color-text-secondary);
		margin-bottom: var(--space-4);
	}

	.card-featured__stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: 0 0 var(--space-4);
		padding: 0;
	}

	.card-featured__stack li {
		font-size: var(--text-xs);
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-text-secondary);
	}

	.card-featured__links {
		display: flex;
		gap: var(--space-4);
		font-size: var(--text-sm);
	}

	.card-featured__links a {
		color: var(--color-accent);
		text-decoration: none;
	}

	@media (max-width: 800px) {
		.card-featured {
			grid-template-columns: 1fr;
		}
	}
</style>
