---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>['data'];
}

const { project } = Astro.props;
const href = project.links.demo ?? project.links.repo ?? '#';
---

<a class="card-archive" href={href}>
	<div class="card-archive__media">
		<img src={project.image} alt="" loading="lazy" />
	</div>
	<h3 class="card-archive__title">{project.title}</h3>
	<ul class="card-archive__stack">
		{project.stack.map((tech) => (
			<li>{tech}</li>
		))}
	</ul>
</a>

<style>
	.card-archive {
		display: block;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg-elevated);
		text-decoration: none;
		transition: transform var(--duration-normal) var(--ease-apple), border-color var(--duration-normal) var(--ease-apple);
	}

	.card-archive:hover {
		transform: translateY(-3px);
		border-color: rgba(255, 255, 255, 0.24);
	}

	.card-archive__media {
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-card);
		margin-bottom: var(--space-3);
		aspect-ratio: 16 / 10;
	}

	.card-archive__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-archive__title {
		font-size: var(--text-sm);
		font-weight: 600;
		margin-bottom: var(--space-2);
	}

	.card-archive__stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.card-archive__stack li {
		font-size: var(--text-xs);
		padding: 0.125rem var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-text-secondary);
	}
</style>
