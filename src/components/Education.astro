---
const entries = [
	{ title: 'M.S. Computer Science — Engineering for Professionals', org: 'Johns Hopkins University', dates: 'Expected 2028' },
	{ title: 'BSc Computer Science', org: 'Ashesi University College', dates: 'Jan 2022 – Jun 2025' },
	{ title: 'AWS Certified Developer – Associate', org: 'Amazon Web Services', dates: 'Sep 2025 – Sep 2028' },
];
---

<section class="section" id="education" data-reveal>
	<div class="container">
		<h2 class="section-heading">Education &amp; Certifications</h2>
		<ul class="education">
			{entries.map((entry) => (
				<li class="education__item">
					<h3 class="education__title">{entry.title}</h3>
					<p class="education__org">{entry.org}</p>
					<p class="education__dates">{entry.dates}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.education {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--space-8);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.education__title {
		font-size: var(--text-base);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--space-1);
	}

	.education__org {
		color: var(--color-text-secondary);
		font-size: var(--text-sm);
	}

	.education__dates {
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
	}
</style>
