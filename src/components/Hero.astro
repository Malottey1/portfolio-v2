---
import ChromeHead from './ChromeHead.astro';
---

<section class="hero" id="top">
	<div class="container hero__inner">
		<ChromeHead />
		<h1 class="hero__name">Malcolm Clottey</h1>
		<p class="hero__role">Software Engineer</p>
		<p class="hero__value">Building full-stack, AI-powered, and cloud-deployed systems.</p>
		<p class="hero__scroll-cue" aria-hidden="true">↓</p>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-32) var(--space-16);
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-6);
	}

	.hero__name {
		font-size: var(--text-4xl);
		letter-spacing: var(--tracking-tighter);
		line-height: var(--leading-tight);
	}

	.hero__role {
		font-size: var(--text-lg);
		color: var(--color-text-secondary);
	}

	.hero__value {
		max-width: 32ch;
		font-size: var(--text-base);
		color: var(--color-text-secondary);
	}

	.hero__scroll-cue {
		margin-top: var(--space-8);
		color: var(--color-text-secondary);
		font-size: var(--text-lg);
		animation: bob 2s var(--ease-apple) infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__scroll-cue {
			animation: none;
		}
	}

	@keyframes bob {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(6px);
		}
	}
</style>
